#!/usr/bin/env python3
"""provisionkit: keep this ProvisionKit checkout on the controller current and healthy.

  provisionkit update     pull the latest main from GitHub, then make sure everything works
  provisionkit check      run the health checks without changing anything
  provisionkit baseline H apply the hardening baseline to one node: dry run, confirmation, apply, then validate
  provisionkit nightly-reboot enable|disable|status   nightly reboot of this controller (nodes use the baseline role)
  provisionkit status     show the version, whether an update is waiting, and the panel state
  provisionkit version    print the installed version
  provisionkit install    put this command on your PATH (/usr/local/bin/provisionkit), needs sudo

Standard library only, so it runs before the virtualenv exists.
"""
import argparse
import ipaddress
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent  # follows the /usr/local/bin symlink back into the checkout
REMOTE, BRANCH = "origin", "main"
UNIT = Path("/etc/systemd/system/provisionkit-panel.service")
LINK = Path("/usr/local/bin/provisionkit")
SERVICE = "provisionkit-panel.service"
ENV_MODULES = "import flask, ruamel.yaml, waitress, jwt, ansible"
RESTART_IF_CHANGED = ("panel/", "scripts/install_panel.sh", "scripts/provisionkit")
DEFAULT_KEY = "/home/provisionkit/.ssh/provisionkit_ed25519"
TAG_RE = re.compile(r"^[a-z_]+(,[a-z_]+)*$")
TIME_RE = re.compile(r"^([01][0-9]|2[0-3]):[0-5][0-9]$")
ZONE_RE = re.compile(r"^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+){0,2}$")
SBIN = Path("/usr/local/sbin")
SYSTEMD_DIR = Path("/etc/systemd/system")
ZONEINFO = Path("/usr/share/zoneinfo")
REBOOT_SCRIPT = "provisionkit-nightly-reboot"
REBOOT_TIMER = "pk-nightly-reboot.timer"
REBOOT_SERVICE = "pk-nightly-reboot.service"
# Runs in the virtualenv (PyYAML comes with Ansible). Prints what the baseline command needs to know about one node.
INVENTORY_FACTS = r"""
import json, sys, yaml
from pathlib import Path
inv = Path("inventories/local")
children = yaml.safe_load((inv / "hosts.yml").read_text())["all"]["children"]
gv_file = inv / "group_vars" / "all.yml"
gv = (yaml.safe_load(gv_file.read_text()) if gv_file.exists() else None) or {}
host = sys.argv[1]
groups, address = [], None
for name, body in children.items():
    entry = ((body or {}).get("hosts") or {})
    if host in entry:
        groups.append(name)
        address = address or (entry[host] or {}).get("ansible_host")
controllers = [(v or {}).get("ansible_host") for v in ((children.get("controllers") or {}).get("hosts") or {}).values()]
print(json.dumps({"groups": groups, "address": address, "controllers": [c for c in controllers if c],
                  "sources": gv.get("provisionkit_management_sources") or [],
                  "firewall_applied": bool(gv.get("provisionkit_firewall_applied", False))}))
"""


class Failure(Exception):
    pass


class Result:
    """One health check outcome: ok, warn or fail."""
    def __init__(self, level, name, detail=""):
        self.level, self.name, self.detail = level, name, detail

    def __repr__(self):
        return f"{self.level}: {self.name}" + (f" ({self.detail})" if self.detail else "")


class Kit:
    def __init__(self, repo=REPO, out=print):
        self.repo = Path(repo)
        self.out = out
        self.owner = pwd.getpwuid(self.repo.stat().st_uid).pw_name
        self.py = self.repo / ".venv" / "bin" / "python"

    # ---- running commands as the account that owns the checkout -----------------------------------------------------
    def sh(self, cmd, check=True, root=False, timeout=600):
        """Run a command in the repo. As root, drop to the checkout's owner so files and ssh keys stay theirs."""
        cmd = [str(c) for c in cmd]
        if not root and os.geteuid() == 0 and self.owner != "root":
            cmd = ["sudo", "-u", self.owner, "-H", *cmd]
        try:
            r = subprocess.run(cmd, cwd=self.repo, text=True, capture_output=True, timeout=timeout,
                               stdin=subprocess.DEVNULL)
        except FileNotFoundError:
            raise Failure(f"{cmd[0]} is not installed.") from None
        except subprocess.TimeoutExpired:
            raise Failure(f"{' '.join(cmd[:3])} timed out.") from None
        if check and r.returncode:
            raise Failure((r.stderr or r.stdout).strip() or f"{' '.join(cmd[:3])} failed")
        return r

    def git(self, *args, check=True):
        return self.sh(["git", *args], check=check)

    # ---- state ------------------------------------------------------------------------------------------------------
    def head(self):
        return self.git("rev-parse", "HEAD").stdout.strip()

    def branch(self):
        return self.git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip()

    def dirty_files(self):
        """Tracked files with local changes. Untracked and ignored files, such as inventories/local, do not count."""
        return [ln for ln in self.git("status", "--porcelain", "--untracked-files=no").stdout.splitlines() if ln]

    def fetch(self):
        r = self.git("fetch", "--prune", REMOTE, BRANCH, check=False)
        if r.returncode:
            raise Failure("Could not reach GitHub: " + ((r.stderr or r.stdout).strip().splitlines() or ["no output"])[-1]
                          + "\nCheck the network and that this account's GitHub key still works.")

    def ahead_behind(self):
        a, b = self.git("rev-list", "--left-right", "--count", f"HEAD...{REMOTE}/{BRANCH}").stdout.split()
        return int(a), int(b)

    def service_installed(self):
        return UNIT.exists()

    def service_active(self):
        r = subprocess.run(["systemctl", "is-active", SERVICE], capture_output=True, text=True)
        return r.stdout.strip() == "active"

    def panel_port(self):
        m = re.search(r"--port\s+(\d+)", UNIT.read_text()) if UNIT.exists() else None
        return int(m.group(1)) if m else 8080

    def panel_responds(self, port=None):
        """Any HTTP answer counts. With PANEL_ALLOWED_HOSTS set the panel answers 400 to a bare 127.0.0.1 request."""
        try:
            urllib.request.urlopen(f"http://127.0.0.1:{port or self.panel_port()}/healthz", timeout=5)
            return True
        except urllib.error.HTTPError:
            return True
        except OSError:
            return False

    # ---- update -----------------------------------------------------------------------------------------------------
    def update(self, skip_env=False, skip_service=False, rollback=True):
        """Fast-forward to origin/main, then make sure the environment, the service and the checks are right."""
        if self.dirty_files():
            raise Failure("This checkout has local changes to tracked files, so it will not update:\n  "
                          + "\n  ".join(self.dirty_files()[:10]) + "\nCommit, stash or discard them first.")
        if self.branch() != BRANCH:
            raise Failure(f"This checkout is on '{self.branch()}', not '{BRANCH}'. Run: git checkout {BRANCH}")
        self.out(f"Fetching {REMOTE}/{BRANCH} ...")
        self.fetch()
        ahead, behind = self.ahead_behind()
        if ahead and behind:
            raise Failure(f"Local main has diverged from GitHub ({ahead} local commit(s), {behind} new on GitHub). "
                          "Nothing was changed. Resolve it by hand.")
        old, changed = self.head(), set()
        if behind:
            self.out(f"{behind} new commit(s):")
            self.out(self.git("log", "--oneline", "--max-count=20", f"HEAD..{REMOTE}/{BRANCH}").stdout.rstrip())
            changed = set(self.git("diff", "--name-only", f"HEAD..{REMOTE}/{BRANCH}").stdout.split())
            self.git("merge", "--ff-only", f"{REMOTE}/{BRANCH}")
            self.out("Updated.")
        else:
            self.out("Already up to date." if not ahead else
                     f"Nothing to pull ({ahead} local commit(s) not on GitHub yet).")
        try:
            if not skip_env:
                self.ensure_env("panel/requirements.txt" in changed)
            if not skip_service:
                self.ensure_service(changed)
        except Failure as e:
            if rollback and old != self.head():
                self.out(f"Problem after updating: {e}\nRolling back to {old[:8]} ...")
                self.git("reset", "--hard", old)
                try:
                    self.ensure_env(True)
                    self.ensure_service(set(changed), force=True)
                except Failure as again:
                    raise Failure(f"Rolled back the code to {old[:8]}, but the service still has a problem: {again}") from e
                raise Failure(f"The update failed and was rolled back to {old[:8]}: {e}") from e
            raise
        results = self.check()
        self.report(results)
        return results

    def ensure_env(self, requirements_changed=False):
        if not self.py.exists():
            self.out("Creating the Python environment ...")
            self.sh(["python3", "-m", "venv", self.repo / ".venv"])
            requirements_changed = True
        elif self.sh([self.py, "-c", ENV_MODULES], check=False).returncode:
            requirements_changed = True
        if requirements_changed:
            self.out("Installing dependencies ...")
            self.sh([self.py, "-m", "pip", "install", "--quiet", "-r", "panel/requirements.txt", "ansible-core<2.20"])

    def unit_is_current(self, port):
        r = self.sh(["bash", "scripts/install_panel.sh", "--print-unit", "--user", self.owner, "--port", str(port)],
                    check=False)
        return r.returncode == 0 and UNIT.exists() and UNIT.read_text() == r.stdout

    def ensure_service(self, changed, force=False):
        if not self.service_installed():
            self.out("The panel service is not installed (sudo scripts/install_panel.sh installs it). Skipping.")
            return
        if os.geteuid() != 0:
            raise Failure("Restarting the panel needs root. Run: sudo provisionkit update")
        port = self.panel_port()
        stale = not self.unit_is_current(port)
        if not (force or stale or not self.service_active() or any(f.startswith(RESTART_IF_CHANGED) for f in changed)):
            self.out("Panel service: no restart needed.")
            return
        self.out("Restarting the panel service ...")
        r = self.sh(["bash", "scripts/install_panel.sh", "--user", self.owner, "--port", str(port), "--skip-admin"],
                    root=True, check=False)
        if r.returncode:
            raise Failure("The panel did not come back healthy.\n" + "\n".join(
                (r.stdout + r.stderr).strip().splitlines()[-12:]))
        self.out("Panel service: restarted and healthy.")

    # ---- checks -----------------------------------------------------------------------------------------------------
    def check(self):
        results = [self.check_git(), self.check_env(), *self.check_playbooks(), self.check_inventory(), self.check_key()]
        if self.service_installed():
            results.append(self.check_service())
        return results

    def check_git(self):
        if self.dirty_files():
            return Result("warn", "git", "local changes to tracked files")
        return Result("ok", "git", f"{self.branch()} at {self.head()[:8]}")

    def check_env(self):
        if not self.py.exists():
            return Result("fail", "python environment", "missing .venv (run: provisionkit update)")
        r = self.sh([self.py, "-c", ENV_MODULES], check=False)
        return Result("ok", "python environment") if not r.returncode else \
            Result("fail", "python environment", "dependencies missing (run: provisionkit update)")

    def check_playbooks(self):
        out, ansible = [], self.repo / ".venv" / "bin" / "ansible-playbook"
        if not ansible.exists():
            return [Result("fail", "playbook syntax", "ansible-playbook not installed in .venv")]
        bad = [p.name for p in sorted((self.repo / "playbooks").glob("*.yml"))
               if self.sh([ansible, "--syntax-check", f"playbooks/{p.name}"], check=False).returncode]
        out.append(Result("fail", "playbook syntax", "errors in " + ", ".join(bad)) if bad else
                   Result("ok", "playbook syntax"))
        return out

    def check_inventory(self):
        inv = self.repo / "inventories" / "local"
        if not inv.exists():
            return Result("warn", "inventory", "inventories/local does not exist yet")
        r = self.sh([self.py, "scripts/validate_inventory.py", "inventories/local"], check=False)
        text = (r.stdout + r.stderr).strip()
        return Result("ok", "inventory") if not r.returncode else Result("fail", "inventory", text.replace("\n", "; "))

    def deploy_key_path(self):
        f = self.repo / "inventories" / "local" / "group_vars" / "all.yml"
        m = re.search(r"^provisionkit_deploy_key_file:\s*['\"]?([^\s'\"]+)", f.read_text(), re.M) if f.exists() else None
        return m.group(1) if m else DEFAULT_KEY

    def check_key(self):
        key = Path(self.deploy_key_path())
        r = self.sh(["test", "-r", key], check=False)
        if r.returncode:
            return Result("fail", "deploy key", f"{key} is missing or not readable by {self.owner}")
        mode = self.sh(["stat", "-c", "%a", key], check=False).stdout.strip()
        if mode and int(mode, 8) & 0o077:
            return Result("warn", "deploy key", f"{key} is accessible to other users (mode {mode}); use 600")
        probe = self.sh(["ssh-keygen", "-y", "-P", "", "-f", key], check=False)
        if probe.returncode:
            return Result("warn", "deploy key", "has a passphrase, so Ansible jobs from the panel and the timer cannot use it")
        return Result("ok", "deploy key")

    def check_service(self):
        if not self.service_active():
            return Result("fail", "panel service", f"{SERVICE} is not running")
        if not self.panel_responds():
            return Result("fail", "panel service", "running but not answering on port " + str(self.panel_port()))
        return Result("ok", "panel service", f"running on 127.0.0.1:{self.panel_port()}")

    def report(self, results):
        self.out("")
        for r in results:
            self.out(f"  {r.level.upper():<4}  {r.name}" + (f": {r.detail}" if r.detail else ""))
        bad = sum(r.level == "fail" for r in results)
        warn = sum(r.level == "warn" for r in results)
        self.out(f"\n{'Everything is good to go.' if not bad and not warn else ''}"
                 f"{f'{bad} problem(s) need attention.' if bad else ''}"
                 f"{f' {warn} warning(s).' if warn else ''}".strip())

    # ---- baseline ---------------------------------------------------------------------------------------------------
    def run_live(self, cmd):
        """Run with the terminal attached, so Ansible's prompts (vault password, the firewall's login confirmation) work."""
        cmd = [str(c) for c in cmd]
        if os.geteuid() == 0 and self.owner != "root":
            cmd = ["sudo", "-u", self.owner, "-H", *cmd]
        try:
            return subprocess.run(cmd, cwd=self.repo).returncode
        except FileNotFoundError:
            raise Failure(f"{cmd[0]} is not installed.") from None

    def inventory_facts(self, host):
        r = self.sh([self.py, "-c", INVENTORY_FACTS, host], check=False)
        if r.returncode:
            raise Failure("Could not read inventories/local: " + (r.stderr.strip().splitlines() or ["unknown error"])[-1])
        return json.loads(r.stdout)

    def playbook(self, name, host, tags, vault, check=False):
        cmd = [self.repo / ".venv/bin/ansible-playbook", f"playbooks/{name}.yml", "-i", "inventories/local/hosts.yml",
               "--limit", host]
        if check:
            cmd += ["--check", "--diff"]
        if tags:
            cmd += ["--tags", tags]
        if vault:
            cmd += ["--ask-vault-pass"]
        return cmd

    def baseline(self, host, tags=None, check_only=False, yes=False, ask_vault=False, allow_dirty=False, ask=input):
        """Dry run, confirm, apply, validate. Changes only the one named node."""
        if tags and not TAG_RE.match(tags):
            raise Failure("Tags must be lowercase names separated by commas, for example: firewall,audit")
        if not (self.repo / "inventories" / "local").exists():
            raise Failure("inventories/local does not exist. Create it first (see the README).")
        problems = self.check_inventory()
        if problems.level == "fail":
            raise Failure("The inventory has problems, fix them first: " + problems.detail)
        facts = self.inventory_facts(host)
        if "workload_nodes" not in facts["groups"]:
            raise Failure(f"'{host}' is not in workload_nodes in inventories/local. The baseline only targets those.")
        if not allow_dirty and self.dirty_files():
            raise Failure("This checkout has uncommitted changes to tracked files. The baseline records the commit on "
                          "the node, and validation rejects a dirty one. Commit or discard them first.")
        touches_firewall = not tags or "firewall" in tags.split(",")
        sources = facts["sources"]
        if touches_firewall:
            missing = self.controllers_not_in(sources, facts["controllers"])
            if missing:
                raise Failure(f"The controller's address {', '.join(missing)} is not covered by "
                              "provisionkit_management_sources. The firewall would block this controller's SSH. Add it first.")
        self.out(f"Baseline for {host} ({facts['address']})" + (f", tags: {tags}" if tags else ", all roles"))
        self.out(f"  configuration commit: {self.head()[:12]}")
        if touches_firewall:
            self.out("  the firewall will allow SSH only from: " + (", ".join(sources) or "(nothing)"))
            self.out("  Make sure your own workstation's address is in that list. The firewall role arms a 10 minute\n"
                     "  rollback timer and asks you to log in from another device before it disarms.")
        self.out("\nStep 1: dry run (changes nothing). If asked to confirm a login from another device, just press\n"
                 "Enter: this is the firewall role's prompt, and nothing has been applied.\n")
        if self.run_live(self.playbook("baseline", host, tags, ask_vault, check=True)):
            raise Failure("The dry run failed. Nothing was changed.")
        if check_only:
            self.out("\nDry run finished. Nothing was changed.")
            return
        if not yes:
            self.out("")
            if ask(f"Type the node's name ({host}) to apply this to it, or anything else to stop: ").strip() != host:
                raise Failure("Stopped. Nothing was changed.")
        self.out(f"\nStep 2: applying to {host} ...\n")
        if self.run_live(self.playbook("baseline", host, tags, ask_vault)):
            raise Failure("The baseline run failed. " + (
                "The firewall role rolls itself back, either now or when its timer fires, so SSH access returns. "
                if touches_firewall else "") + "Fix the cause and run it again.")
        self.out(f"\nStep 3: validating {host} ...\n")
        valid = self.run_live(self.playbook("validate", host, None, ask_vault)) == 0
        self.out("\nValidation passed." if valid else "\nValidation failed. Read the failing task above.")
        if touches_firewall and not facts["firewall_applied"] and valid:
            self.out("\nThe firewall is now enforced. Tell the validation and the panel to check it by adding this line to\n"
                     "inventories/local/group_vars/all.yml:\n\n  provisionkit_firewall_applied: true\n")
        self.out("Then click Collect data on the device in the panel (or wait for the timer) to refresh its status.")
        if not valid:
            raise Failure("Validation failed after applying.")

    # ---- nightly reboot of the controller ---------------------------------------------------------------------------
    def nightly_reboot(self, action, time="00:00", timezone=None, max_wait=30, only_if_required=False):
        """Install, remove or report a nightly reboot timer on this machine. Managed nodes get theirs from the baseline."""
        if action == "status":
            return self.nightly_reboot_status()
        if os.geteuid() != 0:
            raise Failure(f"Run with sudo: sudo provisionkit nightly-reboot {action}")
        if action == "disable":
            self.sh(["systemctl", "disable", "--now", REBOOT_TIMER], check=False, root=True)
            for f in (SYSTEMD_DIR / REBOOT_TIMER, SYSTEMD_DIR / REBOOT_SERVICE, SBIN / REBOOT_SCRIPT):
                f.unlink(missing_ok=True)
            self.sh(["systemctl", "daemon-reload"], root=True)
            self.out("Nightly reboot removed from this machine.")
            return
        if not TIME_RE.match(time):
            raise Failure("The time must look like 00:00 (24 hour clock).")
        if not 1 <= max_wait <= 240:
            raise Failure("The wait must be 1 to 240 minutes.")
        if timezone is not None:
            if not ZONE_RE.match(timezone) or not (ZONEINFO / timezone).is_file():
                raise Failure(f"'{timezone}' is not a time zone name. Try America/New_York or Europe/London.")
            self.sh(["timedatectl", "set-timezone", timezone], root=True)
        src = self.repo / "roles" / "nightly_reboot" / "files" / REBOOT_SCRIPT
        SBIN.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, SBIN / REBOOT_SCRIPT)
        (SBIN / REBOOT_SCRIPT).chmod(0o755)
        (SYSTEMD_DIR / REBOOT_SERVICE).write_text(reboot_service_text(max_wait, only_if_required))
        (SYSTEMD_DIR / REBOOT_TIMER).write_text(reboot_timer_text(time))
        self.sh(["systemctl", "daemon-reload"], root=True)
        self.sh(["systemctl", "enable", REBOOT_TIMER], root=True)
        self.sh(["systemctl", "restart", REBOOT_TIMER], root=True)  # picks up a changed time
        zone = self.sh(["timedatectl", "show", "-p", "Timezone", "--value"], check=False, root=True).stdout.strip()
        self.out(f"This machine will reboot every night at {time} in its time zone ({zone or 'unknown'}).")
        self.out("Check the time zone is yours: timedatectl. Change it with: provisionkit nightly-reboot enable --timezone Area/City")

    def nightly_reboot_status(self):
        installed = (SYSTEMD_DIR / REBOOT_TIMER).exists()
        zone = self.sh(["timedatectl", "show", "-p", "Timezone", "--value"], check=False).stdout.strip()
        if not installed:
            self.out(f"Nightly reboot: not installed on this machine (time zone: {zone or 'unknown'}).")
            return
        enabled = self.sh(["systemctl", "is-enabled", REBOOT_TIMER], check=False).stdout.strip()
        nxt = self.sh(["systemctl", "show", REBOOT_TIMER, "-p", "NextElapseUSecRealtime", "--value"],
                      check=False).stdout.strip()
        when = re.search(r"OnCalendar=\*-\*-\* (\d\d:\d\d):00", (SYSTEMD_DIR / REBOOT_TIMER).read_text())
        self.out(f"Nightly reboot: {enabled or 'unknown'}, at {when.group(1) if when else '?'} ({zone or 'unknown'}). "
                 f"Next: {nxt or 'not scheduled'}")

    @staticmethod
    def controllers_not_in(sources, controllers):
        """Controller addresses that no management source covers. Hostnames are skipped, not guessed at."""
        nets = []
        for src in sources:
            try:
                nets.append(ipaddress.ip_network(str(src), strict=False))
            except ValueError:
                continue
        missing = []
        for c in controllers:
            try:
                ip = ipaddress.ip_address(str(c))
            except ValueError:
                continue
            if not any(ip in n for n in nets):
                missing.append(str(c))
        return missing

    # ---- other commands ---------------------------------------------------------------------------------------------
    def version(self):
        return self.git("log", "-1", "--format=%h %cs %s").stdout.strip()

    def status(self, fetch=True):
        self.out(f"Version: {self.version()}")
        self.out(f"Branch:  {self.branch()}" + ("" if self.branch() == BRANCH else f"  (updates follow {BRANCH})"))
        if fetch:
            try:
                self.fetch()
                ahead, behind = self.ahead_behind()
                self.out("Update:  " + (f"{behind} new commit(s) on GitHub. Run: provisionkit update" if behind
                                        else "up to date"))
            except Failure as e:
                self.out(f"Update:  could not check ({str(e).splitlines()[0]})")
        if self.service_installed():
            self.out("Panel:   " + ("running and answering" if self.service_active() and self.panel_responds()
                                    else "NOT healthy"))
        else:
            self.out("Panel:   service not installed")

    def launcher_current(self):
        want = launcher_text(self.repo / "scripts" / "provisionkit")
        return LINK.is_file() and not LINK.is_symlink() and LINK.read_text() == want

    def install_link(self):
        if os.geteuid() != 0:
            raise Failure("Run with sudo: sudo scripts/provisionkit install")
        target = self.repo / "scripts" / "provisionkit"
        LINK.parent.mkdir(parents=True, exist_ok=True)
        if LINK.is_symlink() or LINK.exists():
            LINK.unlink()  # also replaces the symlink older versions created
        LINK.write_text(launcher_text(target))
        LINK.chmod(0o755)
        self.out(f"Installed {LINK} (runs {target}, through sudo for accounts that cannot read it)")


def reboot_service_text(max_wait, only_if_required, controller=True):
    """Same unit as roles/nightly_reboot/templates, plus waiting for this controller's own update and Ansible jobs."""
    extra = " --wait-for-unit provisionkit-update.service --wait-for-process ansible-playbook" if controller else ""
    flag = " --only-if-required" if only_if_required else ""
    return ("# Managed by ProvisionKit (provisionkit nightly-reboot). Do not edit by hand.\n[Unit]\n"
            "Description=ProvisionKit nightly reboot\n\n[Service]\nType=oneshot\n"
            f"TimeoutStartSec={(max_wait + 5) * 60}\n"
            f"ExecStart={SBIN / REBOOT_SCRIPT} --max-wait {max_wait}{flag}{extra}\n")


def reboot_timer_text(time):
    return ("# Managed by ProvisionKit (provisionkit nightly-reboot). Do not edit by hand.\n[Unit]\n"
            f"Description=ProvisionKit nightly reboot at {time} local time\n\n[Timer]\n"
            f"OnCalendar=*-*-* {time}:00\n"
            "# Not persistent on purpose: a machine that was off at that time must not reboot again right after boot.\n"
            "Persistent=false\nAccuracySec=1s\n\n[Install]\nWantedBy=timers.target\n")


def launcher_text(script):
    """/usr/local/bin/provisionkit. The checkout often sits in a private home directory that other accounts cannot
    enter, so a symlink would look like 'command not found' to them. This launcher falls back to sudo."""
    return ("#!/bin/sh\n"
            "# Installed by 'provisionkit install'. Do not edit.\n"
            f'SCRIPT="{script}"\n'
            'if [ -r "$SCRIPT" ]; then exec "$SCRIPT" "$@"; fi\n'
            'exec sudo "$SCRIPT" "$@"\n')


def needs_root(kit, command, action=None):
    """update needs root only to restart the panel; install always does; nightly-reboot only to change things."""
    if command == "nightly-reboot":
        return action in ("enable", "disable")
    return command == "install" or (command == "update" and kit.service_installed())


def main(argv=None, kit=None):
    ap = argparse.ArgumentParser(prog="provisionkit", description=__doc__, formatter_class=argparse.RawTextHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)
    up = sub.add_parser("update", help="pull the latest main and make sure everything works")
    up.add_argument("--skip-env", action="store_true", help="do not touch the Python environment")
    up.add_argument("--skip-service", action="store_true", help="do not touch the panel service")
    up.add_argument("--no-rollback", action="store_true", help="keep the new code even if the panel fails to start")
    bl = sub.add_parser("baseline", help="apply the hardening baseline to one node (dry run, confirm, apply, validate)")
    bl.add_argument("host", help="a node in workload_nodes, for example pk-worker")
    bl.add_argument("--tags", help="only these roles, comma separated (for example: firewall)")
    bl.add_argument("--check-only", action="store_true", help="dry run only, change nothing")
    bl.add_argument("--yes", action="store_true", help="skip the typed confirmation")
    bl.add_argument("--ask-vault-pass", action="store_true", help="prompt for the Ansible Vault password")
    bl.add_argument("--allow-dirty", action="store_true", help="allow uncommitted changes (validation will reject the node)")
    nr = sub.add_parser("nightly-reboot", help="reboot this controller every night (managed nodes use the baseline)")
    nr.add_argument("action", choices=["enable", "disable", "status"])
    nr.add_argument("--time", default="00:00", help="24 hour time in this machine's time zone (default 00:00)")
    nr.add_argument("--timezone", help="set this machine's time zone first, for example America/New_York")
    nr.add_argument("--max-wait", type=int, default=30, help="minutes to wait for updates to finish (default 30)")
    nr.add_argument("--only-if-required", action="store_true", help="reboot only when a reboot is pending")
    sub.add_parser("check", help="run the health checks")
    st = sub.add_parser("status", help="show version, pending update and panel state")
    st.add_argument("--no-fetch", action="store_true", help="do not contact GitHub")
    sub.add_parser("version", help="print the installed version")
    sub.add_parser("install", help="put this command on your PATH (needs sudo)")
    a = ap.parse_args(argv)

    kit = kit or Kit()
    me = pwd.getpwuid(os.geteuid()).pw_name
    if os.geteuid() != 0 and me != kit.owner:
        print(f"This checkout belongs to {kit.owner}. Run: sudo provisionkit {a.command}", file=sys.stderr)
        return 1
    if needs_root(kit, a.command, getattr(a, "action", None)) and os.geteuid() != 0:
        os.execvp("sudo", ["sudo", str(Path(__file__).resolve()), *sys.argv[1:]])  # prompts for the sudo password
    try:
        if a.command == "update":
            results = kit.update(a.skip_env, a.skip_service, rollback=not a.no_rollback)
            if os.geteuid() == 0 and not kit.launcher_current():
                kit.install_link()
            return 1 if any(r.level == "fail" for r in results) else 0
        if a.command == "baseline":
            kit.baseline(a.host, a.tags, a.check_only, a.yes, a.ask_vault_pass, a.allow_dirty)
            return 0
        if a.command == "nightly-reboot":
            kit.nightly_reboot(a.action, a.time, a.timezone, a.max_wait, a.only_if_required)
            return 0
        if a.command == "check":
            results = kit.check()
            kit.report(results)
            return 1 if any(r.level == "fail" for r in results) else 0
        if a.command == "status":
            kit.status(fetch=not a.no_fetch)
        elif a.command == "version":
            print(kit.version())
        elif a.command == "install":
            kit.install_link()
    except Failure as e:
        print(f"Error: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
