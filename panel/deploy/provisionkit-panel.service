# Template. scripts/install_panel.sh fills in the @...@ values and installs this as
# /etc/systemd/system/provisionkit-panel.service. It runs as the controller user that already has the deploy key and
# the servers' host keys, because the panel starts ansible-playbook as that user.
[Unit]
Description=ProvisionKit Control Center
After=network-online.target

[Service]
User=@RUN_USER@
WorkingDirectory=@REPO@
Environment=PATH=@REPO@/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=ANSIBLE_HOME=@REPO@/panel/instance/ansible-home
# ssh control sockets: short path (Unix sockets are limited to about 108 characters) and writable under ProtectHome.
RuntimeDirectory=provisionkit-panel
RuntimeDirectoryMode=0700
Environment=ANSIBLE_SSH_CONTROL_PATH_DIR=/run/provisionkit-panel/cp
EnvironmentFile=-/etc/provisionkit-panel.env
ExecStart=@REPO@/.venv/bin/python -m panel run --host 127.0.0.1 --port @PORT@
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@REPO@/panel/instance -@REPO@/inventories/local

[Install]
WantedBy=multi-user.target
