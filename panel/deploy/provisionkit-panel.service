# Template. scripts/install_panel.sh fills in the @...@ values and installs this as
# /etc/systemd/system/provisionkit-panel.service. It runs as the controller user that already has the deploy key and
# the servers' host keys, because the panel starts ansible-playbook as that user.
[Unit]
Description=ProvisionKit Control Center
After=network-online.target

[Service]
User=@RUN_USER@
WorkingDirectory=@REPO@
Environment=PATH=@REPO@/.venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/provisionkit-panel.env
ExecStart=@REPO@/.venv/bin/python -m panel run --host 127.0.0.1 --port @PORT@
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The home directory is read-only, except where Ansible keeps its temporary files and ssh control sockets, and the
# known_hosts file, which the panel appends to when an admin trusts a new server's host key, and the request
# directory where the Update button leaves a file for the root-run updater.
ReadWritePaths=@REPO@/panel/instance -@REPO@/inventories/local -@HOME_DIR@/.ansible -@HOME_DIR@/.ssh/known_hosts /var/lib/provisionkit-requests

[Install]
WantedBy=multi-user.target
