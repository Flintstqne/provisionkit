# Install on the controller as /etc/systemd/system/provisionkit-panel.service
# Assumes the repo is at /opt/provisionkit with a venv in /opt/provisionkit/.venv and a dedicated "pkpanel" user
# that can read the repo and the deploy key (provisionkit_deploy_key_file).
[Unit]
Description=ProvisionKit Control Center
After=network-online.target

[Service]
User=pkpanel
WorkingDirectory=/opt/provisionkit
Environment=PATH=/opt/provisionkit/.venv/bin:/usr/bin:/bin
EnvironmentFile=-/etc/provisionkit-panel.env
ExecStart=/opt/provisionkit/.venv/bin/python -m panel run --host 127.0.0.1 --port 8080
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/provisionkit/panel/instance /opt/provisionkit/inventories/local

[Install]
WantedBy=multi-user.target
